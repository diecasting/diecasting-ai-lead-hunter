# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=diecasting-ai-lead-hunter
DEBUG=true

# ---------------------------------------------------------------------------
# PostgreSQL
#   When DATABASE_URL is set it takes precedence over the individual parts.
# ---------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leadhunter
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadhunter

# ---------------------------------------------------------------------------
# OpenAI
#   OPTIONAL — lead scoring (casting_need_score / sales_priority) works without
#   it (deterministic rule-based scoring). The key only enriches the summary.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Crawler (Playwright)
# ---------------------------------------------------------------------------
CRAWLER_HEADLESS=true
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_RETRIES=3
CRAWLER_REQUEST_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Scheduler (Phase 2.5 daily pipeline) — disabled by default
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0
SCHEDULER_MAX_RESULTS=20
KEYWORDS_FILE=data/keywords.txt

# ---------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------
EXPORT_DIR=data/exports

# ---------------------------------------------------------------------------
# SMTP (Phase 2.5 outreach sending) — OPTIONAL
#   Leave blank to run in dry-run mode (no real email sent, but the pipeline
#   still records send events + updates lead status).
#   Examples:
#     Gmail:       SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
#     Enterprise:  SMTP_HOST=mail.yourcompany.com  SMTP_PORT=25  SMTP_USE_TLS=false
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

