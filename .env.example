# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=diecasting-ai-lead-hunter
DEBUG=true

# ---------------------------------------------------------------------------
# PostgreSQL
#   When DATABASE_URL is set it takes precedence over the individual parts.
# ---------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leadhunter
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadhunter

# ---------------------------------------------------------------------------
# OpenAI
#   OPTIONAL — lead scoring (casting_need_score / sales_priority) works without
#   it (deterministic rule-based scoring). The key only enriches the summary.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Crawler (Playwright)
# ---------------------------------------------------------------------------
CRAWLER_HEADLESS=true
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_RETRIES=3
CRAWLER_REQUEST_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Search (Phase 5 Stage 4) — OPTIONAL
#   SEARCH_PROVIDER=serpapi uses the SerpAPI JSON API (production; needs a
#   SERPAPI_KEY). Leave SEARCH_PROVIDER unset (or set to google) to keep the
#   Playwright SERP-scraping fallback.
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=serpapi
SERPAPI_KEY=

# ---------------------------------------------------------------------------
# Scheduler (Phase 2.5 daily pipeline) — disabled by default
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0
SCHEDULER_MAX_RESULTS=20
KEYWORDS_FILE=data/keywords.txt

# ---------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------
EXPORT_DIR=data/exports

# Phase 7: Quora + SEO Authority Engine
QUORA_EXPORT_DIR=data/quora_exports
SEO_BLOG_DIR=data/seo_blog

# ---------------------------------------------------------------------------
# SMTP (Phase 2.5 / Phase 4 Stage 5 outreach sending) — OPTIONAL
#   Leave SMTP_PASSWORD blank to run in dry-run mode (no real email sent; the
#   sending pipeline records the send and advances via an in-memory mock).
#   Examples:
#     Gmail:       SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
#     SiteGround:  SMTP_HOST=sgp14.siteground.asia  SMTP_PORT=465
#                  SMTP_USE_TLS=true (port 465 uses SMTP_SSL implicitly —
#                  STARTTLS is NOT used on 465; see docs/smtp-siteground.md)
#     Enterprise:  SMTP_HOST=mail.yourcompany.com  SMTP_PORT=25  SMTP_USE_TLS=false
#   SMTP_USERNAME is the canonical credential env name (SMTP_USER is a legacy
#   alias that is synced automatically). SMTP_FROM_EMAIL defaults to the login.
# ---------------------------------------------------------------------------
SMTP_HOST=sgp14.siteground.asia
SMTP_PORT=465
SMTP_USERNAME=sales@alumcasting.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=sales@alumcasting.com
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# IMAP (Phase 6 Stage 3 reply inbox connector) — OPTIONAL
#   Leave IMAP_PASSWORD blank to run the in-memory mock connector (dry-run) so
#   the inbox pipeline can be exercised without a real mailbox.
#   AlumCasting SiteGround production (Phase 6 Stage 4):
#     IMAP_HOST=sgp14.siteground.asia  IMAP_PORT=993  IMAP_USE_SSL=true
#     IMAP_USERNAME=sales@alumcasting.com  (IMAP_FOLDER=INBOX)
#   Gmail example: IMAP_HOST=imap.gmail.com  IMAP_PORT=993  IMAP_USE_SSL=true
# ---------------------------------------------------------------------------
IMAP_HOST=sgp14.siteground.asia
IMAP_PORT=993
IMAP_USERNAME=sales@alumcasting.com
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX

