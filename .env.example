# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=diecasting-ai-lead-hunter
DEBUG=true

# ---------------------------------------------------------------------------
# PostgreSQL
#   When DATABASE_URL is set it takes precedence over the individual parts.
# ---------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leadhunter
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadhunter

# ---------------------------------------------------------------------------
# OpenAI
#   OPTIONAL — lead scoring (casting_need_score / sales_priority) works without
#   it (deterministic rule-based scoring). The key only enriches the summary.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Crawler (Playwright)
# ---------------------------------------------------------------------------
CRAWLER_HEADLESS=true
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_RETRIES=3
CRAWLER_REQUEST_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Scheduler (Phase 2.5 daily pipeline) — disabled by default
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0
SCHEDULER_MAX_RESULTS=20
KEYWORDS_FILE=data/keywords.txt

# ---------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------
EXPORT_DIR=data/exports

# ---------------------------------------------------------------------------
# SMTP (Phase 2.5 / Phase 4 Stage 5 outreach sending) — OPTIONAL
#   Leave blank to run in dry-run mode (no real email sent; the sending
#   pipeline records the send and advances to 'sent' via an in-memory mock).
#   Examples:
#     Gmail:       SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
#     Enterprise:  SMTP_HOST=mail.yourcompany.com  SMTP_PORT=25  SMTP_USE_TLS=false
#   SMTP_USERNAME is the canonical credential env name (SMTP_USER is a legacy
#   alias that is synced automatically). SMTP_FROM_EMAIL defaults to the login.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# IMAP (Phase 6 Stage 3 reply inbox connector) — OPTIONAL
#   Leave blank to run the in-memory mock connector (dry-run) so the inbox
#   pipeline can be exercised without a real mailbox.
#   Gmail example: IMAP_HOST=imap.gmail.com  IMAP_PORT=993  IMAP_USE_SSL=true
# ---------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX

